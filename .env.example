# DawaSnap AI Environment Variables

# Server Configuration (Google Cloud Run / Container)
PORT=8080
PUBLIC_BASE_URL=https://noorpos.in
ALLOWED_ORIGINS=https://noorpos.in,https://www.noorpos.in,https://dawasnap.cloud.run,https://dawalens.cloud.run,https://dawasnap.vercel.app,https://dawalens.vercel.app,capacitor://localhost,https://localhost
CRON_SECRET=

# Google Gemini API Key (Server-side proxy)
GEMINI_API_KEY=

# Resend API Key (Transactional email alerts & deletion verification)
RESEND_API_KEY=

# Firebase Admin Service Account (Optional on Cloud Run if attached Service Account is used via Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public Backend URL for Frontend & Native Mobile APK
VITE_BACKEND_URL=https://dawasnap.cloud.run

# Android Release Signing (CI/CD Runner or keystore.properties)
ANDROID_STORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Supabase PostgreSQL Backup Integration
SUPABASE_URL=https://kizepsjjgznzuewwgemt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
