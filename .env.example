# DawaSnap AI Environment Variables

# Server Configuration
PORT=3000
ALLOWED_ORIGINS=https://dawasnap.vercel.app,https://dawasnapai.onrender.com,capacitor://localhost,https://localhost
CRON_SECRET=

# Google Gemini API Key (Server-side proxy)
GEMINI_API_KEY=

# Resend API Key (Transactional email alerts & deletion verification)
RESEND_API_KEY=

# Firebase Admin Service Account Key JSON string (for FCM HTTP v1 notifications & server operations)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public Frontend & Backend URLs
VITE_BACKEND_URL=https://dawasnapai.onrender.com
RENDER_EXTERNAL_URL=https://dawasnapai.onrender.com

# Android Release Signing (CI/CD Runner or keystore.properties)
ANDROID_STORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Supabase PostgreSQL Backup Integration
SUPABASE_URL=https://kizepsjjgznzuewwgemt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
